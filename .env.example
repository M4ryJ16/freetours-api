PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:root@localhost:5432/tours

# Required on EVERY request via the "x-api-key" header.
API_KEY=change-me-super-secret-api-key

# Required in ADDITION to the API key, via the "x-publish-key" header,
# on any endpoint that creates/updates/deletes published content
# (tours, tour gallery images, standalone image records).
PUBLISH_KEY=change-me-super-secret-publish-key

# Image uploads. UPLOAD_DIR is where files are saved on disk, relative to
# where the process runs. PUBLIC_BASE_URL is optional — if unset, the
# served URL is derived from each request's protocol/host instead.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
PUBLIC_BASE_URL='http://localhost:3000'

# --- Auth: email verification code + JWT ---

# Required. Secret used to sign customer session JWTs. Use a long random
# string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-super-secret-jwt-signing-key
JWT_EXPIRES_IN=7d

MANAGE_BOOKING_URL='http://localhost:4321/bookings/'

# SMTP — used to actually email the verification codes. If SMTP_HOST is
# left blank, the mailer plugin logs the code instead of sending it
# (useful for local dev without a mail provider configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# OpenStreetMap — meeting-point map image in ticket emails (optional)
# Defaults use the public tile.openstreetmap.org server, which is
# free but asks that you not send it heavy production traffic
# (https://operations.osmfoundation.org/policies/tiles/). For low
# volume this is fine as-is; for anything more, point OSM_TILE_URL
# at a self-hosted tile server or a commercial OSM-tile host (Stadia
# Maps, Thunderforest, MapTiler, etc).
# ============================================================
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_TILE_USER_AGENT=tours-meriyo-dublin/1.0 (contact: you@yourdomain.com)

# ============================================================
# Daily reservations summary email (optional)
# Sent automatically every day at midnight (SUMMARY_EMAIL_TZ) with a
# table of reservation counts and party composition (adults/children/
# babies/pets) for today through SUMMARY_EMAIL_RANGE_DAYS days ahead —
# the same default range shown in the admin Reservas panel. If
# SUMMARY_EMAIL is left blank, the job is disabled. Uses the same SMTP_*
# settings above; if SMTP_HOST is unset, the summary is logged instead
# of emailed.
# ============================================================

# Recipient address for the daily summary. Leave blank to disable the job.
SUMMARY_EMAIL=

# Recipient address for the tickets. Leave blank to disable the job.
RETICKETS_EMAIL=

# IANA timezone used both to decide when "midnight" is and to compute
# "today" for the summary's date range — should match where the tours
# actually run, not necessarily where the server is hosted.
SUMMARY_EMAIL_TZ=Europe/Dublin

# How many days ahead of today the summary covers.
SUMMARY_EMAIL_RANGE_DAYS=30